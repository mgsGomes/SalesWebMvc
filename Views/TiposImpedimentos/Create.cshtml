@model SalesWebMvc.Models.TipoImpedimento


@{
    ViewData["Title"] = "Novo Tipo de Impedimento";
}

<h2>@ViewData["Title"]</h2>

<h4>Impedimento</h4>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group">
                <label asp-for="Impedimento" class="control-label"></label>
                <input asp-for="Impedimento" class="form-control" />
                <span asp-validation-for="Impedimento" class="text-danger"></span>
            </div>            
            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar</a>
</div>

@section Scripts{
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}